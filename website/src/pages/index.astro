---
import BaseLayout from '../layouts/BaseLayout.astro';
import MagicSwordBanner from '../components/MagicSwordBanner.astro';
import DriverExplorer from '../components/DriverExplorer.astro';
import ResourceCards from '../components/ResourceCards.astro';
import RecentDrivers from '../components/RecentDrivers.astro';
import CatalogMetrics from '../components/CatalogMetrics.astro';
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <div class="eyebrow">
        <span class="dot"></span>Living Off The Land Drivers
      </div>
      <h1 id="hero-title">
        Know the driver.
        <br />
        <span>Understand the risk.</span>
      </h1>
      <p class="intro">
        Explore vulnerable and malicious Windows drivers. Find the hashes,
        examine the evidence, and put detections to work.
      </p>
      <div class="hero-actions">
        <a href="#explorer">Find a driver</a>
        <a href="/detections/">Get detections</a>
        <a href="/tools/">Explore tools</a>
      </div>
    </div>
    <RecentDrivers />
  </section>
  <CatalogMetrics />
  <MagicSwordBanner />
  <DriverExplorer />
  <ResourceCards />
</BaseLayout>
